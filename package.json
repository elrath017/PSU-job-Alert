{
  "name": "psu-job-alert-dashboard",
  "version": "1.0.0",
  "description": "Real-time PSU & Govt Job Alert Dashboard for CS/IT vacancies",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "psu",
    "jobs",
    "cs",
    "it",
    "gemini-ai",
    "express",
    "react",
    "sqlite"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemon": "^3.1.14",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  }
}
